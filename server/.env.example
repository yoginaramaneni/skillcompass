# SkillCompass Server Environment Example

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillcompass 
JWT_SECRET=your_jwt_secret_key_here 
JWT_EXPIRES_IN=7d 
GEMINI_API_KEY=Gemini API Key Here
# Market Data Freshness Thresholds (Days)
 
MARKET_DATA_FRESH_DAYS=90

MARKET_DATA_AGING_DAYS=180